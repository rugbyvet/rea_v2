    %% Solid arrow: imports from the layer above to the one below. Dashed arrow: imports upward, a port or type defined above. Each label counts import statements.
    %% Every layer imports the pure core, 4971 imports in all (ADAPTERS->CORE 579, COMPOSITION->CORE 33, APPLICATION->CORE 1873, PROVIDERS->CORE 1982, FOUNDATION->CORE 96, CONFIG->CORE 79, UNMAPPED->CORE 329), drawn once as the bottom box instead of as arrows.
    %% Arrows under 10 imports are not drawn: ADAPTERS->UNMAPPED 9, COMPOSITION->ADAPTERS 3, COMPOSITION->FOUNDATION 6, COMPOSITION->CONFIG 7, PROVIDERS->UNMAPPED 6, FOUNDATION->CONFIG 6, CONFIG->ADAPTERS 1, CONFIG->APPLICATION 2, CONFIG->FOUNDATION 1.
    ADAPTERS["CLI and MCP adapters<br/>cli/, cli.ts, cliBrowserScenarioCommands.ts, cliBuiltinArguments.ts, cliCommandNames.ts, cliConfiguration.ts, cliEvidenceCommands.ts<br/>cliJsonInput.ts, cliLogging.ts, cliObservationOptions.ts, cliOutput.ts, doctorRuntime.ts, main/, main.ts<br/>mcpDoctor.ts, mcpDoctorOptions.ts, server/<br/>parse a command or MCP call and return the result"]
    COMPOSITION["Composition<br/>composition/<br/>production factories construct fresh providers and bind them to the workflows"]
    APPLICATION["Shared application workflows<br/>application/<br/>CLI/MCP use cases, sessions and investigation records"]
    PROVIDERS["Provider adapters<br/>android/, artifacts/, browser/, captures/, compression/, dotnet/, evm/<br/>firmware/, ghidra/, go/, gpu/, hopper/, ida/, il2cpp/<br/>inspector/, javascript/, model/, native/, providers/, python/, reference/<br/>rust/, signals/, sqlite/, wasm/<br/>each wraps one engine, runtime or file format"]
    FOUNDATION["Provider process foundation<br/>filesystem/, process/, windows/<br/>owned processes, Windows host boundary and owned file handles that providers build on"]
    CONFIG["Configuration and shared identity<br/>catalogIdentity.ts, config/, generatedPackageMetadata.ts, identity.ts, logger.ts, mcpStartupPolicy.ts, recordedCatalogDigests.ts<br/>recordedMcpCatalog.ts, serverIdentity.ts<br/>validated environment settings, product and catalog identity, logging"]
    UNMAPPED["Not yet mapped<br/>adb/, apkSignature/, apktool/, cutter/, desktop/, electron/, erlang/<br/>flutter/, frida/, gdb/, jeb/, kuna/, objdump/, pcap/<br/>rizin/<br/>named by neither the sets in this script, scripts/lib/module-boundaries.mjs nor the provider catalog"]
    CORE["Pure core: domain semantics and contracts<br/>contracts/, domain/<br/>imported by every layer, imports nothing above"]
